//novo Cargo
router.post("/novoCargo", (req, res) => {
  const { cargo, descricao } = req.body;

  const sql = `
    INSERT INTO cargos
    (CARGO, DESCRICAO)
    VALUES (?, ?)
  `;

  const valores = [cargo, descricao];
  db.query(sql, valores, (err) => {
    if (err) {
      console.error(err);
      return res.status(500).json({ mensagem: "Erro ao salvar no banco" });
    }

    res.json({ mensagem: "Cadastro salvo com sucesso!" });
  });
});

